{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*", "index.html", "tailwind.config.js"],
  "parserOptions": {
    "project": [
      "apps/admin/tsconfig.app.json",
      "apps/admin/tsconfig.spec.json",
      "apps/admin/tsconfig.editor.json"
    ]
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "plugin:@nx/angular",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/component-class-suffix": "off",
        "@angular-eslint/directive-class-suffix": "off",
        "@angular-eslint/component-selector": [
          "error",
          { "type": "element", "prefix": "ja", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "ja", "style": "camelCase" }
        ],
        "@angular-eslint/prefer-on-push-component-change-detection": "error",
        "@angular-eslint/prefer-signals": "error",
        "@angular-eslint/prefer-inject": "error",
        "@angular-eslint/prefer-output-readonly": "error",
        "@angular-eslint/no-uncalled-signals": "error",
        "@nx/workspace-no-cross-page-imports": "error",
        "lines-between-class-members": [
          "error",
          {
            "enforce": [
              { "blankLine": "always", "prev": "field", "next": "method" },
              { "blankLine": "always", "prev": "method", "next": "method" }
            ]
          }
        ],
        "padding-line-between-statements": [
          "error",
          {
            "blankLine": "always",
            "prev": ["const", "let", "var"],
            "next": "*"
          },
          {
            "blankLine": "any",
            "prev": ["const", "let", "var"],
            "next": ["const", "let", "var"]
          }
        ]
      }
    },
    {
      "files": ["src/app/pages/**/*.ts"],
      "excludedFiles": ["*.spec.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@angular/common/http",
                "message": "Pages call the typed clients in shared/api instead of HttpClient."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@nx/angular-template"],
      "rules": {
        "@angular-eslint/template/prefer-control-flow": "error",
        "@angular-eslint/template/prefer-self-closing-tags": "error",
        "@angular-eslint/template/button-has-type": "error"
      }
    }
  ]
}
