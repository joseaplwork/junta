{
  "name": "@junta/mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "jm",
  "sourceRoot": "apps/mobile/src",
  "tags": ["type:app", "scope:mobile"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/mobile",
        "index": "apps/mobile/src/index.html",
        "browser": "apps/mobile/src/main.ts",
        "tsConfig": "apps/mobile/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/mobile/public" }],
        "styles": [
          "node_modules/@ionic/angular/css/core.css",
          "node_modules/@ionic/angular/css/normalize.css",
          "node_modules/@ionic/angular/css/structure.css",
          "node_modules/@ionic/angular/css/typography.css",
          "node_modules/@ionic/angular/css/padding.css",
          "node_modules/@ionic/angular/css/flex-utils.css",
          "node_modules/@ionic/angular/css/text-alignment.css",
          "node_modules/@ionic/angular/css/palettes/dark.system.css",
          "apps/mobile/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/mobile/src/environments/environment.ts",
              "with": "apps/mobile/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "port": 4300,
        "proxyConfig": "apps/mobile/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "@junta/mobile:build:production"
        },
        "development": {
          "buildTarget": "@junta/mobile:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/mobile/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ngc -p apps/mobile/tsconfig.app.json --noEmit && tsc -p apps/mobile/tsconfig.spec.json --noEmit"
      }
    },
    "cap-add": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap add {args.platform}",
        "cwd": "apps/mobile"
      }
    },
    "cap-sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync",
        "cwd": "apps/mobile"
      }
    },
    "cap-open": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx cap open {args.platform}",
        "cwd": "apps/mobile"
      }
    },
    "cap-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["cap-sync"],
      "options": {
        "command": "npx cap run {args.platform}",
        "cwd": "apps/mobile"
      }
    }
  }
}
