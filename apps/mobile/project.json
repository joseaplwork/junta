{
  "name": "@junta/mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mobile/src",
  "tags": ["type:app", "scope:mobile"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npx expo start", "cwd": "apps/mobile" }
    },
    "ios": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npx expo start --ios", "cwd": "apps/mobile" }
    },
    "android": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npx expo start --android", "cwd": "apps/mobile" }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/mobile"],
      "options": {
        "command": "npx expo export --platform ios --platform android --output-dir ../../dist/mobile",
        "cwd": "apps/mobile"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "apps/mobile/jest.config.js" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/mobile"
      }
    },
    "doctor": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "npx expo-doctor", "cwd": "apps/mobile" }
    }
  }
}
