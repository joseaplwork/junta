# Copy to apps/api/.env (git-ignored). Nx loads it for every @junta/api task.
PORT=3000
# Comma-separated origins allowed to call the API. Native builds of the mobile
# app also need capacitor://localhost (iOS) and https://localhost (Android).
CORS_ORIGIN=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=juntas
DB_LOGGING=false

# Any long random string. Never reuse the development value in production.
JWT_SECRET=change-me
JWT_ACCESS_TTL=1m
JWT_REFRESH_TTL=7d

# Used only by `nx e2e @junta/api`. Must end in _e2e: the suite drops and recreates it.
E2E_DB_NAME=juntas_e2e
