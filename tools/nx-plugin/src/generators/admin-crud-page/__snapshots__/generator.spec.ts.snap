"import {
  ChangeDetectionStrategy,
  Component,
  inject,
  signal,
} from '@angular/core'
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms'
import { MatCheckboxModule } from '@angular/material/checkbox'
import { MAT_DIALOG_DATA, MatDialogRef } from '@angular/material/dialog'
import { MatFormFieldModule } from '@angular/material/form-field'
import { MatInputModule } from '@angular/material/input'

import {
  CreateSampleRecordRequest,
  SampleRecordResponse,
} from '@junta/contracts'

import { CrudDialogShell } from '@/admin/shared/components/crud'
import {
  fromDateInputValue,
  toDateInputValue,
} from '@/admin/shared/forms/date-input'

export interface SampleRecordFormDialogData {
  title: string
  submitLabel: string
  /** Prefills the form when editing. */
  sampleRecord: SampleRecordResponse | null
  /** Resolves true when saved. The dialog stays open otherwise. */
  handleSubmit: (request: CreateSampleRecordRequest) => Promise<boolean>
}

/** Shared by create-feat and update-feat, so it lives at page level. */
@Component({
  templateUrl: './sample-record-form-dialog.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
  imports: [
    ReactiveFormsModule,
    MatCheckboxModule,
    MatFormFieldModule,
    MatInputModule,
    CrudDialogShell,
  ],
})
export class SampleRecordFormDialog {
  private readonly _dialogRef = inject(MatDialogRef<SampleRecordFormDialog>)
  private readonly _fb = inject(FormBuilder).nonNullable

  readonly data = inject<SampleRecordFormDialogData>(MAT_DIALOG_DATA)
  readonly submitting = signal(false)
  readonly form = this._fb.group({
    title: [this.data.sampleRecord?.title ?? '', Validators.required],
    amount: [this.data.sampleRecord?.amount ?? 0, Validators.required],
    dueDate: [toDateInputValue(this.data.sampleRecord?.dueDate), Validators.required],
    sent: [this.data.sampleRecord?.sent ?? false],
    notes: [this.data.sampleRecord?.notes ?? ''],
  })

  async onSubmit(): Promise<void> {
    if (this.form.invalid || this.submitting()) return

    this.submitting.set(true)

    const saved = await this.data.handleSubmit(this._toRequest())

    this.submitting.set(false)

    if (saved) this._dialogRef.close()
  }

  onCancel(): void {
    this._dialogRef.close()
  }

  private _toRequest(): CreateSampleRecordRequest {
    const value = this.form.getRawValue()

    return {
      title: value.title,
      amount: value.amount,
      dueDate: fromDateInputValue(value.dueDate),
      sent: value.sent,
      notes: value.notes || null,
    }
  }
}
"
`;

exports[`admin-crud-page generator after the API resource exists renders apps/admin/src/app/pages/sample-record/delete-feat/delete-feat.ts from the field spec 1`] = `
"import {
  ChangeDetectionStrategy,
  Component,
  effect,
  inject,
} from '@angular/core'

import { SampleRecordResponse } from '@junta/contracts'

import { SampleRecordsApi } from '@/admin/shared/api/sample-records-api'
import {
  CrudDeleteDialog,
  DeleteDialogData,
} from '@/admin/shared/components/crud'
import { Dialog } from '@/admin/shared/services/dialog'
import { Snackbar } from '@/admin/shared/services/snackbar'

import { SampleRecordPageState } from '../sample-record-page-state'

@Component({
  selector: 'ja-sample-record-delete-feat',
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: '',
})
export class DeleteFeat {
  private readonly _dialog = inject(Dialog)
  private readonly _sampleRecordsApi = inject(SampleRecordsApi)
  private readonly _state = inject(SampleRecordPageState)
  private readonly _snackbar = inject(Snackbar)

  constructor() {
    effect(() => {
      const sampleRecord = this._state.deleteRequest()

      if (!sampleRecord) return

      this._state.requestDelete(null)
      this._openDialog(sampleRecord)
    })
  }

  private _openDialog(sampleRecord: SampleRecordResponse): void {
    this._dialog.open<CrudDeleteDialog, DeleteDialogData>(CrudDeleteDialog, {
      entityName: 'Sample Record',
      displayName: sampleRecord.title,
      handleDelete: () => this._delete(sampleRecord),
    })
  }

  private async _delete(sampleRecord: SampleRecordResponse): Promise<boolean> {
    try {
      await this._sampleRecordsApi.remove(sampleRecord.id)
      this._state.emitDeleted(sampleRecord)
      this._snackbar.success('Sample record deleted')

      return true
    } catch {
      this._snackbar.error('Failed to delete sample record')

      return false
    }
  }
}
"
`;

exports[`admin-crud-page generator after the API resource exists renders apps/admin/src/app/pages/sample-record/list-feat/list-feat.ts from the field spec 1`] = `
"import {
  ChangeDetectionStrategy,
  Component,
  effect,
  inject,
  signal,
} from '@angular/core'

import { SampleRecordResponse } from '@junta/contracts'

import { SampleRecordsApi } from '@/admin/shared/api/sample-records-api'
import {
  ActionConfig,
  ColumnConfig,
  CrudDataTable,
} from '@/admin/shared/components/crud'
import { Snackbar } from '@/admin/shared/services/snackbar'

import { SampleRecordPageState } from '../sample-record-page-state'

@Component({
  selector: 'ja-sample-record-list-feat',
  templateUrl: './list-feat.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
  imports: [CrudDataTable],
})
export class ListFeat {
  private readonly _state = inject(SampleRecordPageState)
  private readonly _sampleRecordsApi = inject(SampleRecordsApi)
  private readonly _snackbar = inject(Snackbar)

  readonly columns: ColumnConfig<SampleRecordResponse>[] = [
    { key: 'title', header: 'Title', type: 'text' },
    { key: 'amount', header: 'Amount', type: 'currency' },
    { key: 'dueDate', header: 'Due Date', type: 'date' },
    { key: 'sent', header: 'Sent', type: 'chip', chipColor: value => (value ? 'green' : 'gray'), chipLabel: value => (value ? 'Yes' : 'No') },
    { key: 'notes', header: 'Notes', type: 'text' },
  ]

  readonly actions: ActionConfig = { edit: true, delete: true }
  readonly sampleRecords = signal<SampleRecordResponse[]>([])
  readonly loading = signal(false)
  readonly error = signal<string | null>(null)

  constructor() {
    void this._load()

    effect(() => {
      const created = this._state.created()

      if (created) this.sampleRecords.update(list => [...list, created])
    })

    effect(() => {
      const updated = this._state.updated()

      if (updated) {
        this.sampleRecords.update(list =>
          list.map(item => (item.id === updated.id ? updated : item)),
        )
      }
    })

    effect(() => {
      const deleted = this._state.deleted()

      if (deleted) {
        this.sampleRecords.update(list =>
          list.filter(item => item.id !== deleted.id),
        )
      }
    })
  }

  edit(sampleRecord: SampleRecordResponse): void {
    this._state.requestUpdate(sampleRecord)
  }

  remove(sampleRecord: SampleRecordResponse): void {
    this._state.requestDelete(sampleRecord)
  }

  private async _load(): Promise<void> {
    this.loading.set(true)
    this.error.set(null)

    try {
      this.sampleRecords.set(await this._sampleRecordsApi.list())
    } catch {
      this.error.set('Failed to load sample records')
      this._snackbar.error('Failed to load sample records')
    } finally {
      this.loading.set(false)
    }
  }
}
"
`;

exports[`admin-crud-page generator after the API resource exists renders apps/admin/src/app/shared/api/sample-records-api.ts from the field spec 1`] = `
"import { Injectable, inject } from '@angular/core'

import {
  ApiResource,
  CreateSampleRecordRequest,
  SampleRecordResponse,
  UpdateSampleRecordRequest,
} from '@junta/contracts'

import { ApiClient } from './api-client'

/** Mirrors SampleRecordsController in apps/api. */
@Injectable({ providedIn: 'root' })
export class SampleRecordsApi {
  private readonly _api = inject(ApiClient)
  private readonly _path = ApiResource.sampleRecords

  list(): Promise<SampleRecordResponse[]> {
    return this._api.get(this._path)
  }

  get(id: string): Promise<SampleRecordResponse> {
    return this._api.get(\`\${this._path}/\${id}\`)
  }

  create(request: CreateSampleRecordRequest): Promise<SampleRecordResponse> {
    return this._api.post(this._path, request)
  }

  update(
    id: string,
    request: UpdateSampleRecordRequest,
  ): Promise<SampleRecordResponse> {
    return this._api.patch(\`\${this._path}/\${id}\`, request)
  }

  remove(id: string): Promise<void> {
    return this._api.delete(\`\${this._path}/\${id}\`)
  }
}
"
`;
