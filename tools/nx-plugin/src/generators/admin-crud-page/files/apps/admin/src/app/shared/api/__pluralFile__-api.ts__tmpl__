import { Injectable, inject } from '@angular/core'

import {
  ApiResource,
  Create<%- singularClass %>Request,
  <%- singularClass %>Response,
  Update<%- singularClass %>Request,
} from '@junta/contracts'

import { ApiClient } from './api-client'

/** Mirrors <%- pluralClass %>Controller in apps/api. */
@Injectable({ providedIn: 'root' })
export class <%- pluralClass %>Api {
  private readonly _api = inject(ApiClient)
  private readonly _path = ApiResource.<%- pluralProperty %>

  list(): Promise<<%- singularClass %>Response[]> {
    return this._api.get(this._path)
  }

  get(id: string): Promise<<%- singularClass %>Response> {
    return this._api.get(`${this._path}/${id}`)
  }

  create(request: Create<%- singularClass %>Request): Promise<<%- singularClass %>Response> {
    return this._api.post(this._path, request)
  }

  update(
    id: string,
    request: Update<%- singularClass %>Request,
  ): Promise<<%- singularClass %>Response> {
    return this._api.patch(`${this._path}/${id}`, request)
  }

  remove(id: string): Promise<void> {
    return this._api.delete(`${this._path}/${id}`)
  }
}
