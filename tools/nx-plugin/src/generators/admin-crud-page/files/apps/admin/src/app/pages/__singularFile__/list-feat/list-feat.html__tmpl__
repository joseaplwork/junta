<ja-crud-data-table
  emptyMessage="No <%- pluralLabel.toLowerCase() %> found. Click the + button to create one."
  loadingMessage="Loading <%- pluralLabel.toLowerCase() %>..."
  [data]="<%- pluralProperty %>()"
  [columns]="columns"
  [actions]="actions"
  [loading]="loading()"
  [error]="error()"
  (edit)="edit($event)"
  (delete)="remove($event)" />
