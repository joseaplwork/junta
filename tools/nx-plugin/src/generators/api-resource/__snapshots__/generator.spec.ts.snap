"import { Column, Entity, PrimaryGeneratedColumn } from 'typeorm'

import { numericTransformer } from '@/api/database/numeric.transformer'

@Entity('SampleRecords')
export class SampleRecord {
  @PrimaryGeneratedColumn('uuid')
  id: string

  @Column({ type: 'varchar' })
  title: string

  @Column({ type: 'decimal', precision: 10, scale: 2, transformer: numericTransformer })
  amount: number

  @Column({ name: 'due_date', type: 'timestamptz' })
  dueDate: Date

  @Column({ type: 'boolean' })
  sent: boolean

  @Column({ type: 'int' })
  attempts: number

  @Column({ type: 'varchar', nullable: true })
  notes: string | null
}
"
`;

