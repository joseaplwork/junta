"import { SampleRecordResponse } from '@junta/contracts'

import { SampleRecord } from './entities/sample-record.entity'

export function toSampleRecordResponse(
  sampleRecord: SampleRecord,
): SampleRecordResponse {
  return {
    id: sampleRecord.id,
    title: sampleRecord.title,
    amount: sampleRecord.amount,
    dueDate: sampleRecord.dueDate.toISOString(),
    sent: sampleRecord.sent,
    attempts: sampleRecord.attempts,
    notes: sampleRecord.notes,
  }
}
"
`;

